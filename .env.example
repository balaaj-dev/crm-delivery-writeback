# Airtable — config source of truth
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=applraTn50dXBSMrM
AIRTABLE_CLIENTS_TABLE_ID=tblt13hM89s9U72J9

# fixtures | airtable — defaults to fixtures so the app runs with zero credentials
CONFIG_SOURCE=fixtures

# true = route every CRM call through the mock adapter and log the intended call.
# false = make real API calls. Never flip this in a shared environment without
# everyone in the room agreeing to it — see docs/HANDOVER.md.
DRY_RUN=true

# Base URL this app is reachable at, used when registering Smartlead webhooks
PUBLIC_BASE_URL=http://localhost:3000

# Login gate (middleware.ts) — HTTP Basic Auth for the wizard, the event log,
# and every API route except the incoming Smartlead webhook (which uses its
# own per-client secret instead — see app/api/webhooks/smartlead/route.ts).
# Leave both unset for open local dev. Set both before deploying anywhere
# reachable from outside one laptop.
SETUP_AUTH_USER=
SETUP_AUTH_PASS=

# Encrypts CRM credentials before they touch disk (lib/crypto.ts) — 32 raw
# bytes, base64-encoded. Generate with: openssl rand -base64 32
# Leave unset for local dev (falls back to plaintext with a logged warning);
# set it before any real client's credentials are stored anywhere durable.
CONFIG_ENCRYPTION_KEY=

LOG_LEVEL=info

# Session-config and delivery-job persistence (lib/kv.ts) — Upstash Redis via
# the Vercel↔Upstash Marketplace integration (free tier). Connecting the
# integration to the project auto-injects these — nothing to type by hand.
# Leave both unset for local dev: falls back to local JSON files under data/
# (unchanged local behavior). Required once deployed anywhere with a
# read-only filesystem (e.g. Vercel) — without these, wizard-configured
# clients and delivery jobs silently fail to persist across requests. See
# docs/HANDOVER.md.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Drives delivery jobs to completion on Vercel (lib/qstash.ts) — Upstash
# QStash, connected the same way as the Redis integration above (same
# Upstash account, separate Marketplace connection). Without this, a job
# record persists correctly but nothing keeps processing it once Vercel
# freezes the function instance that started it — confirmed live, a job sat
# at status "queued" indefinitely with zero progress. Leave all three unset
# for local dev: falls back to running the whole job in-process (correct
# there, the process stays alive). QSTASH_TOKEN is for publishing the
# "process the next chunk" message; the two signing keys are for verifying
# that an incoming request to app/api/delivery/jobs/[id]/process really came
# from QStash (that route is deliberately outside middleware.ts's Basic Auth
# gate, since QStash can't present one). All three come from the same
# Upstash QStash dashboard/integration. See docs/HANDOVER.md.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Testing-only override — never commit a real value. Set this in a local
# .env.local (gitignored) to substitute a real HubSpot Private App token onto
# every fixture client so you can test the HubSpot adapter against a real
# portal without waiting on the Airtable fields. See docs/HANDOVER.md.
HUBSPOT_TEST_ACCESS_TOKEN=
